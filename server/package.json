{
  "name": "typeoye-server",
  "version": "1.0.0",
  "description": "Typeoye typing platform backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed": "ts-node src/seed/seed.ts",
    "seed:practice": "ts-node src/seed/seedPracticeParagraphs.ts",
    "seed:test": "ts-node src/seed/seedTestParagraphs.ts",
    "seed:certificate": "ts-node src/seed/seedCertificateParagraphs.ts",
    "promote:admin": "ts-node src/seed/promoteAdmin.ts",
    "test": "ts-node src/services/wpm.service.test.ts && ts-node src/services/gamification.service.test.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "nodemailer": "^9.1.0",
    "pdfkit": "^0.19.1",
    "resend": "^6.25.0",
    "zod": "^3.22.4",
    "@types/node": "^24.13.4",
    "typescript": "^5.3.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.2"
  }
}
